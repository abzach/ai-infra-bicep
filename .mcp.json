{
  "servers": {
    "bicep": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "-y",
        "Azure.Bicep.McpServer"
      ]
    },
    "azure": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "Azure.Mcp@2.0.5",
        "--yes",
        "--",
        "server",
        "start"
      ],
      "env": {
        "AZURE_MCP_COLLECT_TELEMETRY": "false"
      }
    }
  }
}
